# The URL you access the app from in your browser
ORIGIN=http://localhost:3000

# Database connection string — keep this in sync with the credentials below
DB_URL=postgres://your_username:your_password@db:5432/airtrail

# Postgres credentials — DB_URL above must match these
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE_NAME=airtrail

# Path inside the container for uploaded files (airline icons etc)
# Leave as-is for Docker — omit if you don't need file uploads
UPLOAD_LOCATION=/app/uploads